      "id": "PY-01",
      "severity": "learner_content_failure",
      "item": "python:0",
      "field": "choiceExplanations.None",
      "exact_text": "Boolean operators return boolean values; None only appears when a function has no explicit return.",
      "explanation": "The statement incorrectly generalizes that Boolean operators return Boolean values: and/or return one of their operands. None is a built-in constant and is not limited to functions without explicit return. The exact answer True is still correct, but the returned teaching is false.",
      "counterexamples": {
        "'operand' or False": "'operand'",
        "[] and True": "[]",
        "None": "None"
      },
      "sources": [
        "https://docs.python.org/3/builtins/stdtypes.html#boolean-operations-and-or-not",
        "https://docs.python.org/3/builtins/constants.html#None"
      ]
    }
