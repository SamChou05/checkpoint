+              + json.dumps(data, ensure_ascii=False, allow_nan=False)
+              + "\n</authored_feedback_audit_json>")
+    raw = audit(FULL_FEEDBACK_AUDIT_SYSTEM_PROMPT, prompt, len(survivors))
+
+    def difficulty_gate(index: int, assessed: int) -> bool:
+        target = next((plan["targetDifficulty"] for plan in request.get("adaptiveSkillPlans", [])
+                       if plan["skillID"] == survivors[index].get("skillID")), None)
+        if assessed < request.get("minimumDifficulty", 1):
+            record_quality(request_metrics, "review", "difficulty_floor")
+            return False
+        if target is not None and assessed != target:
+            record_quality(request_metrics, "review", "difficulty_target")
+            return False
+        return True
+
+    try:
+        accepted_indexes = feedback_audit.accepted_indices(raw, payloads, difficulty_gate=difficulty_gate)
+        rows = feedback_audit.validate(raw, len(survivors))
+    except (TypeError, ValueError) as error:
+        record_quality(request_metrics, "review", "invalid_feedback", len(survivors))
+        raise ProviderError("Immutable feedback audit violated its contract.") from error
+    accepted = []
+    for index, question in enumerate(survivors):
+        if index not in accepted_indexes:
+            record_quality(request_metrics, "review", "rejected_by_model")
+            continue
+        if _learner_content(question) != payloads[index]:
+            raise ProviderError("Audited learner content cannot change before release.")
+        verified = copy.deepcopy(question)
+        verified["difficulty"] = rows[str(index)]["difficulty"]
+        verified["verificationVersion"] = VERIFICATION_VERSION
+        verified["verificationPolicyRevision"] = FULL_AUTHORED_FEEDBACK_VERIFICATION_POLICY_REVISION
+        accepted.append(verified)
+        record_quality(request_metrics, "review", "accepted")
+    return accepted
