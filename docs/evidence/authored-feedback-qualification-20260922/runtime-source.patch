@@ -0,0 +1,135 @@
+"""Three-stage immutable authored teaching, after generation and sanitization.
+
+All five teaching fields precede the independent solver and final audit. Code
+enforces exact identities, unchanged text and declared admission conditions;
+model judgments are still fallible statements about educational content.
+"""
+
+import copy
+import hashlib
+import json
+from typing import Any, Callable
+
+import authored_feedback_audit as feedback_audit
+from authored_feedback_contract import LEARNER_FIELDS, freeze_learner_payload
+from complete_question_solution import (
+    CompleteSolutionFormatError,
+    build_solver_prompt,
+    rejection_reason,
+    validate_batch,
+)
+from generation_diagnostics import record_quality
+from question_difficulty import DIFFICULTY_RUBRIC
+from question_verification import _contains_answer_label_references, _has_reviewable_choices
+from service_errors import ProviderError
+from verification_policy import FULL_AUTHORED_FEEDBACK_VERIFICATION_POLICY_REVISION, VERIFICATION_VERSION
+
+
+StageCall = Callable[[str, str, int], str]
+FULL_FEEDBACK_AUDIT_SYSTEM_PROMPT = feedback_audit.AUDIT_SYSTEM_PROMPT + "\n\nDifficulty rubric:\n" + DIFFICULTY_RUBRIC
+
+
+def _learner_content(question: dict[str, Any]) -> dict[str, Any]:
+    return freeze_learner_payload({field: question[field] for field in LEARNER_FIELDS})
+
+
+def verify_authored_feedback(
+    questions: list[dict[str, Any]],
+    request: dict[str, Any],
+    solve: StageCall,
+    audit: StageCall,
+    request_metrics: dict[str, Any] | None = None,
+) -> list[dict[str, Any]]:
+    """Release only frozen originals that pass both independent model stages."""
+    frozen = []
+    for question in questions:
+        try:
+            content = _learner_content(question)
+        except (KeyError, TypeError, ValueError):
+            record_quality(request_metrics, "review", "invalid_feedback")
+            continue
+        if not _has_reviewable_choices(question):
+            record_quality(request_metrics, "review", "invalid_choices")
+            continue
+        if any(_contains_answer_label_references(text, question)
+               for text in [content["explanation"], *content["choiceExplanations"].values()]):
+            record_quality(request_metrics, "review", "answer_labels")
+            continue
+        frozen.append(copy.deepcopy(question))
+    if not frozen:
+        return []
+
+    items = []
+    for index, question in enumerate(frozen):
+        choices = list(question["choices"])
+        offset = int(hashlib.sha256(question["prompt"].encode()).hexdigest()[:8], 16) % 4
+        items.append({
+            "index": index, "prompt": question["prompt"],
+            "choices": choices[offset:] + choices[:offset],
+            **{field: question[field] for field in ("skillID", "objectiveID", "objective", "topic")
+               if field in question},
+        })
+    try:
+        system, prompt = build_solver_prompt(items, request, audit_choice_pairs=True, choice_slots=True)
+    except CompleteSolutionFormatError:
+        record_quality(request_metrics, "review", "invalid_solution", len(items))
+        return []
+    raw = solve(system, prompt, len(items))
+    try:
+        solutions = validate_batch(raw, items, audit_choice_pairs=True, choice_slots=True)
+    except CompleteSolutionFormatError:
+        record_quality(request_metrics, "review", "invalid_solution", len(items))
+        return []
+
+    survivors = []
+    for solution, question in zip(solutions, frozen, strict=True):
+        reason = rejection_reason(solution, question, audit_choice_pairs=True)
+        if reason is not None:
+            record_quality(request_metrics, "review", reason)
+        else:
+            survivors.append(question)
+    if not survivors:
+        return []
+
+    # Scope is whitelisted; keys, difficulty, history and previous approvals are
+    # never passed to this independent full-content audit. Teaching can reveal
+    # the intended answer, so this is not an assertion that the audit is blind.
+    payloads = [_learner_content(question) for question in survivors]
+    scope = {key: copy.deepcopy(request.get(key)) for key in ("goal", "skillMap", "sourceDocuments")}
+    data = feedback_audit.build_input(payloads, scope)
