    {
      "id": "q002",
      "authored": {
        "prompt": "Table: A(X) rows 1, NULL. Table: B(Y) rows NULL, 2. Query: SELECT A.X FROM A LEFT JOIN B ON A.X=B.Y WHERE B.Y IS NULL. What is returned?",
        "explanation": "LEFT JOIN produces (1, NULL) and (NULL, NULL). WHERE B.Y IS NULL keeps both. However, ordinary equality in ON: 1=NULL is NULL (no match), NULL=NULL is NULL (no match). Both left rows are unmatched, so both have B.Y NULL.",
        "expectedAnswer": "1, NULL",
        "choices": [
          "1",
          "NULL",
          "1, NULL",
          "No rows"
        ],
        "choiceFeedback": [
          {
            "choice": "1",
            "explanation": "Incorrect: The NULL row in A also has B.Y NULL after left join and passes the filter."
          },
          {
            "choice": "NULL",
            "explanation": "Incorrect: The row with A.X=1 is unmatched (1=NULL is false in ON), so B.Y is NULL and it passes."
          },
          {
            "choice": "1, NULL",
            "explanation": "Correct: Both A rows are unmatched in the join (no ON equality holds), so both have B.Y NULL and satisfy WHERE."
          },
          {
            "choice": "No rows",
            "explanation": "Incorrect: LEFT JOIN guarantees all A rows appear; with no matches, B.Y is NULL for both."
          }
        ],
        "topic": "SQLite left joins and NULL handling",
        "difficulty": 3,
        "format": "Multiple Choice"
      },
