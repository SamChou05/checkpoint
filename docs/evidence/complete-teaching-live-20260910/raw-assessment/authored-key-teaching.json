    {
      "id": "q003",
      "authored": {
        "prompt": "Table: U(V) rows 1, 1, 2. Query Q1: SELECT DISTINCT V FROM U WHERE V>1. Query Q2: SELECT V FROM U WHERE V>1 GROUP BY V. How do results differ?",
        "explanation": "Both queries return one row with value 2. DISTINCT removes duplicates after filtering; GROUP BY collapses to one row per group. With no aggregate, both produce identical single-row output.",
        "expectedAnswer": "Both return identical single-row results",
        "choices": [
          "Q1 returns 2; Q2 returns 2, 2",
          "Q1 returns 2; Q2 returns no rows",
          "Both return identical single-row results",
          "Q1 returns no rows; Q2 returns 2"
        ],
        "choiceFeedback": [
          {
            "choice": "Q1 returns 2; Q2 returns 2, 2",
            "explanation": "Incorrect: DISTINCT and GROUP BY both collapse duplicates; neither produces duplicate 2s."
          },
          {
            "choice": "Q1 returns 2; Q2 returns no rows",
            "explanation": "Incorrect: GROUP BY with no aggregate still returns grouped values; V=2 passes the filter."
          },
          {
            "choice": "Both return identical single-row results",
            "explanation": "Correct: After filtering to V=2, both DISTINCT and GROUP BY yield one row containing 2."
          },
          {
            "choice": "Q1 returns no rows; Q2 returns 2",
            "explanation": "Incorrect: The filter V>1 is applied in both queries, and 2 satisfies it."
          }
        ],
        "topic": "SQLite duplicate results and grouping",
        "difficulty": 3,
        "format": "Multiple Choice"
      },
