    {
      "id": "q001",
      "authored": {
        "prompt": "Table: T(A) with rows 1, 2, NULL. Query: SELECT A FROM T WHERE A NOT IN (SELECT B FROM S WHERE B>0). Table S(B) is empty. What is returned?",
        "explanation": "NOT IN with an empty right-hand set returns true for every left value, including NULL, because no counterexample exists. SQLite keeps all three rows.",
        "expectedAnswer": "1, 2, NULL",
        "choices": [
          "1, 2",
          "1, 2, NULL",
          "NULL only",
          "No rows"
        ],
        "choiceFeedback": [
          {
            "choice": "1, 2",
            "explanation": "Incorrect: NULL is also returned because NOT IN with an empty set is true even for NULL."
          },
          {
            "choice": "1, 2, NULL",
            "explanation": "Correct: NOT IN against an empty set yields true for all values, including NULL, so all rows pass."
          },
          {
            "choice": "NULL only",
            "explanation": "Incorrect: Non-NULL values also satisfy NOT IN when the right set is empty."
          },
          {
            "choice": "No rows",
            "explanation": "Incorrect: An empty right set makes NOT IN true, not false; rows are kept."
          }
        ],
        "topic": "SQLite membership tests",
        "difficulty": 3,
        "format": "Multiple Choice"
      },
