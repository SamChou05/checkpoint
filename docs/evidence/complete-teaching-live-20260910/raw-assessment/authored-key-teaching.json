    {
      "id": "q004",
      "authored": {
        "prompt": "Tables: P(K) rows 5, 10; Q(K, M) rows (5, NULL), (5, 1). Query: SELECT P.K FROM P WHERE EXISTS (SELECT 1 FROM Q WHERE Q.K=P.K AND Q.M>0). What is returned?",
        "explanation": "EXISTS checks if the subquery returns any rows. For P.K=5, Q has row (5,1) where M>0 is true, so EXISTS is true. For P.K=10, no Q rows match, so EXISTS is false.",
        "expectedAnswer": "5",
        "choices": [
          "5",
          "5, 10",
          "10",
          "No rows"
        ],
        "choiceFeedback": [
          {
            "choice": "5",
            "explanation": "Correct: EXISTS is true for P.K=5 due to matching row (5,1); false for P.K=10 with no matches."
          },
          {
            "choice": "5, 10",
            "explanation": "Incorrect: P.K=10 has no matching Q rows, so EXISTS evaluates to false and is excluded."
          },
          {
            "choice": "10",
            "explanation": "Incorrect: P.K=10 has no Q matches; EXISTS is false. P.K=5 satisfies the condition."
          },
          {
            "choice": "No rows",
            "explanation": "Incorrect: P.K=5 has at least one matching row with M>0, so EXISTS is true."
          }
        ],
        "topic": "SQLite EXISTS and subqueries",
        "difficulty": 3,
        "format": "Multiple Choice"
      },
