+"""Author prompt placement for prose teaching and distractor checks; no provider calls."""
+
+import os
+import unittest
+from unittest.mock import patch
+
+from native_output_contracts import native_prompt
+from quantitative_authoring import CONSTRUCTED_AUTHOR_CONTRACT, CONSTRUCTED_AUTHOR_INSTRUCTIONS
+from question_generation import _system_prompt
+
+
+DISTRACTOR_CHECK = "Each must be demonstrably wrong for the full"
+RULE_CHECK = "include the limits of any general rule and its fallback"
+
+
+class AuthoredProseSemanticPromptTests(unittest.TestCase):
+    def prompt(self, *, feedback="authored_solution", variant="balanced"):
+        with patch.dict(os.environ, {
+            "QUESTION_FEEDBACK_CONTRACT": feedback,
+            "CHECKPOINT_PROMPT_VARIANT": variant,
+        }):
+            return _system_prompt()
+
+    def test_prose_and_constructed_native_authors_keep_checks_in_teaching(self):
+        prose = native_prompt(self.prompt(), "question_author_v3")
+        constructed = native_prompt(self.prompt(), CONSTRUCTED_AUTHOR_CONTRACT)
+        for prompt in (prose, constructed):
+            with self.subTest(contract="constructed" if prompt is constructed else "prose"):
+                self.assertEqual(prompt.count(DISTRACTOR_CHECK), 1)
+                self.assertEqual(prompt.count(RULE_CHECK), 1)
+                self.assertLess(prompt.index("The main explanation is the complete worked solution"),
+                                prompt.index(DISTRACTOR_CHECK))
+                self.assertLess(prompt.index(DISTRACTOR_CHECK), prompt.index(RULE_CHECK))
+                self.assertIn("explicitly scope the rule to this case", prompt)
+                self.assertIn("replace a choice if a common exception", prompt)
+        self.assertNotIn(CONSTRUCTED_AUTHOR_INSTRUCTIONS, prose)
+        self.assertTrue(constructed.endswith(CONSTRUCTED_AUTHOR_INSTRUCTIONS))
+        self.assertLess(constructed.index(RULE_CHECK),
+                        constructed.index(CONSTRUCTED_AUTHOR_INSTRUCTIONS))
+
+    def test_historical_variants_keep_their_own_instructions(self):
+        variants = {
+            "balanced": None,
+            "focused_application": "Joint outcomes are appropriate",
+            "checklist": "Prompt experiment variant: checklist",
+            "method-first": "Prompt experiment variant: checklist",
+            "compact": "Prompt experiment variant: compact",
+        }
+        for variant, marker in variants.items():
+            with self.subTest(variant=variant):
+                prompt = self.prompt(variant=variant)
+                self.assertEqual(prompt.count(DISTRACTOR_CHECK), 1)
+                self.assertEqual(prompt.count(RULE_CHECK), 1)
+                if marker:
+                    self.assertIn(marker, prompt)
+                if variant in {"checklist", "method-first", "compact"}:
+                    self.assertLess(prompt.index(RULE_CHECK), prompt.index(marker))
+                if variant == "focused_application":
+                    self.assertIn("several reasoning steps can establish one precisely asked result", prompt)
+
+    def test_reviewer_written_prompt_does_not_acquire_authored_prose_checks(self):
+        prompt = self.prompt(feedback="reviewer_written")
+        self.assertNotIn(DISTRACTOR_CHECK, prompt)
+        self.assertNotIn(RULE_CHECK, prompt)
+        self.assertNotIn("The main explanation is the complete worked solution", prompt)
+
+
+if __name__ == "__main__":
+    unittest.main()
