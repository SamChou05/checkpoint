  "runner_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport sys\n\nsys.path.insert(0, '/tmp/checkpoint-chess-checker-20260906')\nimport chess\n\nready = ['e4', 'e5', 'Nf3', 'Nc6', 'Bc4', 'Nf6']\ncases = [\n    {'id': 'initial_obstructed', 'moves': [], 'expected': [True, True, False]},\n    {'id': 'path_cleared', 'moves': ready, 'expected': [True, True, True]},\n    {'id': 'king_moved_and_returned', 'moves': ready + ['Ke2', 'Nb8', 'Ke1', 'Nc6'], 'expected': [False, False, False]},\n    {'id': 'rook_moved_and_returned', 'moves': ready + ['Rg1', 'Nb8', 'Rh1', 'Nc6'], 'expected': [False, True, False]},\n    {'id': 'temporary_bishop_obstacle', 'moves': ready + ['Bf1', 'Nb8'], 'expected': [True, True, False]},\n    {'id': 'temporary_obstacle_removed', 'moves': ready + ['Bf1', 'Nb8', 'Bc4', 'Nc6'], 'expected': [True, True, True]},\n]\nfor row in cases:\n    board = chess.Board()\n    row['trace'] = []\n    for san in row['moves']:\n        move = board.parse_san(san)\n        assert move in board.legal_moves\n        board.push(move)\n        row['trace'].append({'san': san, 'fen': board.fen()})\n    row['final_fen'] = board.fen()\n    row['library_valid_position'] = board.is_valid()\n    row['standard_start_legal_move_replay'] = True\n    row['actual'] = [board.has_kingside_castling_rights(chess.WHITE), board.has_queenside_castling_rights(chess.WHITE), chess.Move.from_uci('e1g1') in board.legal_moves]\n    row['matches_expected'] = row['actual'] == row['expected']\n\nreport = {\n    'kind': 'Local chess-engine observations for assistant-created source sanity controls; not generated MCQ evaluation',\n    'date': '2026-09-06', 'chess_version': chess.__version__,\n    'chess_module_sha256': hashlib.sha256(Path(chess.__file__).read_bytes()).hexdigest(),\n    'source': 'https://handbook.fide.com/chapter/E012023',\n    'observed_property_order': ['white_kingside_right', 'white_queenside_right', 'white_kingside_castle_is_legal_now'],\n    'cases': cases, 'runner_source': Path(__file__).read_text(),\n    'limits': ['These six positions were reached by replaying legal moves from the standard initial position; arbitrary FEN validity alone is not a proof of historical reachability.', 'No arbitrary model-authored chess explanation or difficulty was checked.'],\n}\npath = Path('/tmp/checkpoint-chess-evidence-preflight-20260906.json')\npath.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\\n')\nprint(json.dumps({'path': str(path), 'sha256': hashlib.sha256(path.read_bytes()).hexdigest(), 'results': [{'id': row['id'], 'matches': row['matches_expected']} for row in cases]}))\nassert all(row['matches_expected'] and row['library_valid_position'] for row in cases)\n",
