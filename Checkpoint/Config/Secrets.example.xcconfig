// Copy this file to Secrets.xcconfig and fill in the values locally.
// Do not commit Secrets.xcconfig.

CHECKPOINT_AI_BACKEND_ENDPOINT = https:/$()/your-lambda-url.lambda-url.us-east-1.on.aws/
CHECKPOINT_AI_BACKEND_TOKEN = replace-with-backend-token

// Required before App Store release. Use public HTTPS pages owned by the app.
CHECKPOINT_PRIVACY_POLICY_URL = https:/$()/example.com/checkpoint/privacy
CHECKPOINT_SUPPORT_URL = https:/$()/example.com/checkpoint/support

// Optional: keep Apple's standard EULA or replace it with a public custom terms page.
CHECKPOINT_TERMS_OF_USE_URL = https:/$()/www.apple.com/legal/internet-services/itunes/dev/stdeula/
