// Copy this file to Secrets.xcconfig and fill in the values locally.
// Do not commit Secrets.xcconfig.

CHECKPOINT_AI_BACKEND_ENDPOINT = https:/$()/your-lambda-url.lambda-url.us-east-1.on.aws/
// Use a random value of at least 24 characters and configure the same value in Lambda.
CHECKPOINT_AI_BACKEND_TOKEN = replace-with-a-long-random-backend-token
