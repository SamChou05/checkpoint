// Copy this file to Secrets.xcconfig and fill in the values locally.
// Do not commit Secrets.xcconfig.

CHECKPOINT_AI_BACKEND_ENDPOINT = https:/$()/your-api-id.execute-api.us-east-1.amazonaws.com/prod/v1/questions
// Use a random value of at least 32 characters and configure the same value in the backend stack.
CHECKPOINT_AI_BACKEND_TOKEN = replace-with-at-least-32-random-characters

// Add real hosted launch URLs before distribution. In xcconfig files, write
// `https://` as `https:/$()/` so `//` is not parsed as a comment.
CHECKPOINT_PRIVACY_POLICY_URL =
CHECKPOINT_SUPPORT_URL =
